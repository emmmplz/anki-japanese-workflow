{
  "host": "127.0.0.1",
  "port": 17863,
  "max_queue_size": 8,
  "max_text_length": 1000,
  "languages": [
    "ja"
  ],
  "default_language": "ja",
  "default_voice": "default",
  "warmup_text": "こんにちは。",
  "backend": {
    "factory": "tts_service.backends.gpt_sovits:GPTSoVITSBackend",
    "options": {
      "repo_root": "../external/GPT-SoVITS-v2Pro",
      "device": "xpu",
      "is_half": false,
      "threads": 6,
      "version": "v2ProPlus",
      "text_split_method": "cut0",
      "max_segment_chars": 150,
      "t2s_weights_path": "local-models/sentence.ckpt",
      "vits_weights_path": "local-models/sentence.pth",
      "bert_base_path": "GPT_SoVITS/pretrained_models/chinese-roberta-wwm-ext-large",
      "cnhuhbert_base_path": "GPT_SoVITS/pretrained_models/chinese-hubert-base",
      "model_name": "User configured V2ProPlus"
    }
  },
  "voices": [
    {
      "id": "default",
      "name": "自备日语参考音色",
      "language": "ja",
      "options": {
        "reference_audio": "../external/voices/sentence-reference.wav",
        "reference_language": "ja",
        "reference_text": "こんにちは。今日はよい天気ですね。"
      }
    }
  ]
}
